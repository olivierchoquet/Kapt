{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo test *)",
      "Bash(cargo tree *)",
      "Bash(pkg-config *)",
      "Bash(gst-inspect-1.0 *)"
    ],
    "ask": [
      "Bash(cargo run *)",
      "Bash(cargo add *)",
      "Bash(cargo update *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
